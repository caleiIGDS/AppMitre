# Las bases viven todas en database/ (ver database/LEEME.md, que SÍ va a git). La regla es
# por extensión y no por carpeta, así el LEEME viaja y los datos no.
*.db
# Copias previas a una migración, que deja `python actualizar.py`: son datos reales
# de la escuela y no terminan en .db, así que no las agarra la regla de arriba.
*.pre-actualizacion-*

# Notas del asistente: las escribe la app (y el propio agente) en el disco del server.
# En git se pisarían en cada deploy — ver agente/notas.py.
agente.md
agente.md.bak

# PDFs generados por Salidas educativas (contienen DNI y datos de salud)
salidas_pdfs/

# Fotos de recursos (database/fotos/): archivos binarios, no viajan por git (ver
# database/LEEME.md)
database/fotos/

# Padrón de estudiantes (DNI) — fuente para cargar estudiantes.db, nunca se commitea
*.xlsx

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.toast
.lucid
.cache
.pytest_cache/
nosetests.xml
coverage.xml
.coverage
.hypothesis/

# Flask
instance/
.webassets-cache

# Data files (Generated or private)
horarios_actualizados.csv
datos.csv
nombre_mapeos.json

# Secrets
.env

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
